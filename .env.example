# ─────────────────────────────────────────────────────────────────────────────
# Sports Injury Recovery Assistant — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your real API keys below
# 3. NEVER commit the .env file to git (it's in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# Groq API key  →  https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API key  →  https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Optional tuning ──────────────────────────────────────────────────────────
# Groq model for TriageAgent and ReflectionAgent (fast & cheap)
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter model for RAGAgent (higher-reasoning)
OPENROUTER_MODEL=anthropic/claude-3-haiku

# How many RAG chunks to retrieve per query
RAG_TOP_K=4

# Path to ChromaDB storage folder (relative to project root)
CHROMA_DB_PATH=./chroma_db

# Name of the ChromaDB collection
CHROMA_COLLECTION=sports_injury_kb
